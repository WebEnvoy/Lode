{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lode://schema/account-system-template-index/v1",
  "title": "Lode AccountSystem template index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "entries"],
  "properties": {
    "schema_version": {"const": "lode.account-system-template-index.v1"},
    "index_id": {"const": "lode.account-system-templates"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_ref", "version", "path", "sha256"],
      "properties": {
        "template_ref": {
          "type": "string",
          "pattern": "^lode://account-system/[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "path": {
          "type": "string",
          "pattern": "^account-systems/[a-z0-9][a-z0-9._-]*/[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lode://schema/site-skill/devto/opencli-latest-articles/input@0.1.0",
  "type": "object",
  "required": [],
  "properties": {
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)$"
        }
      ],
      "default": 20
    },
    "page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|1000)$"
        }
      ],
      "default": 1
    }
  },
  "additionalProperties": false
}
